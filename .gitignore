# macOS
.DS_Store

# Dependencies — capture tooling only; reinstall with `cd capture && npm ci`
capture/node_modules/

# Ground-truth reference PNGs. Deliberately not tracked file-by-file:
# 452 PNGs / ~451 MB. Portability comes from MANIFEST.sha256 (tracked) plus the
# reference bundle. See capture/reference/README.md.
capture/reference/**/*.png

# The reference bundle itself is 435 MB, over GitHub's 100 MB per-file limit,
# so it cannot be tracked here. Obtain it out-of-band before running verify.mjs.
capture/reference-bundle-*.tar.gz

# Large derived capture evidence — regenerated by capture.mjs, restored from the bundle
capture/dom/**/computed.json
capture/dom/**/page.html

# Gate output — regenerated by every verify.mjs run
capture/diffs/
